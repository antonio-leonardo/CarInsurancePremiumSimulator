# Copy to .env and adjust. Every value is validated at startup; an invalid
# value stops the process from booting.

# --- Calculation rules ---
AGE_RATE_INCREMENT=0.005
BASE_RATE=0
COVERAGE_PERCENTAGE=1.00
MINIMUM_APPLIED_RATE=0
# MAXIMUM_APPLIED_RATE: leave empty for no ceiling (PRODUCT-DECISION)
MAXIMUM_APPLIED_RATE=
# MAX_DEDUCTIBLE_PERCENTAGE: 1.0 allows a 100% deductible (PRODUCT-DECISION)
MAX_DEDUCTIBLE_PERCENTAGE=1.0
MIN_VEHICLE_YEAR=1900
VALUE_BAND_AMOUNT=10000
VALUE_RATE_INCREMENT=0.005
RULES_VERSION=2026.08.0

# --- Precision / currency ---
CURRENCY_CODE=USD
MONEY_DECIMAL_PLACES=2
MONEY_ROUNDING_MODE=ROUND_HALF_UP
RATE_DECIMAL_PLACES=6
RATE_ROUNDING_MODE=ROUND_HALF_UP

# --- Input ceilings (values above these are 422, never 500) ---
# MAX_VEHICLE_VALUE default 1e11, MAX_BROKER_FEE default 1e9 (PRODUCT-DECISION, ADR 0013)
MAX_VEHICLE_VALUE=100000000000
MAX_BROKER_FEE=1000000000

# --- Time ---
BUSINESS_TIMEZONE=UTC

# --- Persistence (OPTIONAL) ---
PERSISTENCE_ENABLED=false
DATABASE_URL=postgresql+psycopg://insurance:insurance@db:5432/insurance
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# PERSISTENCE_FAILURE_MODE: fail_closed | fail_open
PERSISTENCE_FAILURE_MODE=fail_closed

# --- GIS (OPTIONAL, bonus) ---
GIS_ENABLED=false
GIS_BASE_URL=
GIS_API_KEY=
GIS_TIMEOUT_SECONDS=1.5
# GIS_FAILURE_MODE: fail_closed => 503 | fail_open => adjustment 0
GIS_FAILURE_MODE=fail_closed
GIS_MIN_ADJUSTMENT=-0.02
GIS_MAX_ADJUSTMENT=0.02

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
